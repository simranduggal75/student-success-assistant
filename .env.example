# Copy this file to .env and fill in your own values. Never commit .env.
# Any OpenAI-compatible chat API works. Examples of the base URL:
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=model_id_from_your_provider
# seconds to wait between calls (keeps free tiers under their rate limit)
LLM_DELAY=2
# optional, for "thinking" models such as Gemini: low = faster answers (leave empty if unsure)
LLM_REASONING_EFFORT=
